# Data-analysis variant of the offline image.
#
# Same offline bundle as test/offline/Dockerfile, plus a CLI toolbox for
# analysing CSV data sets described by Markdown documents. Every tool is
# reachable from the agent's shell (PATH is set for both ENV and login shells).
#
# Build (from repo root, after building the bundle into dist/):
#   docker build -f test/offline/Dockerfile.analysis -t opencode-offline-analysis .
FROM --platform=linux/amd64 golang:1.27.1-trixie AS miller

ARG MILLER_VERSION=6.22.0

# Rebuild rather than copying a release binary with an older embedded Go runtime.
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOSUMDB=sum.golang.org GOPROXY=https://proxy.golang.org
RUN GOBIN=/out go install -trimpath "github.com/johnkerl/miller/v6/cmd/mlr@v${MILLER_VERSION}" \
	&& go version -m /out/mlr > /out/miller-build.txt

FROM --platform=linux/amd64 python:3.13.16-slim-trixie AS toolbox

# No DNF/system Python, vim, libxml2 bindings or libevent-based ncat in the runtime.
RUN apt-get update \
	&& apt-get upgrade -y \
	&& apt-get install -y --no-install-recommends \
		findutils gawk sed grep diffutils file less tar gzip xz-utils zip unzip \
		procps lsof iproute2 netcat-openbsd jq git passwd libstdc++6 curl tree \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=miller /out/mlr /usr/local/bin/mlr
COPY --from=miller /out/miller-build.txt /usr/local/share/miller-build.txt

ENV ANALYSIS_VENV=/opt/analysis-venv/.venv
COPY test/offline/analysis-requirements.txt /tmp/analysis-requirements.txt
RUN mkdir -p /opt/analysis-venv \
	&& python3 -m venv "$ANALYSIS_VENV" \
	&& "$ANALYSIS_VENV/bin/pip" install --no-cache-dir -r /tmp/analysis-requirements.txt \
	&& "$ANALYSIS_VENV/bin/pip" check \
	&& rm -f /tmp/analysis-requirements.txt

FROM toolbox

COPY dist/opencode-offline-linux-x64/ /opt/opencode/
COPY test/offline/test-offline.sh /opt/opencode/test-offline.sh
COPY test/offline/test-analysis-tools.sh /opt/opencode/test-analysis-tools.sh
RUN chmod +x /opt/opencode/test-offline.sh /opt/opencode/test-analysis-tools.sh \
	&& mkdir -p /opt/opencode/tools/bin \
	&& ln -sf /opt/opencode/deps/ripgrep/rg /opt/opencode/tools/bin/rg \
	&& ln -sf /opt/opencode/bin/opencode /opt/opencode/tools/bin/opencode

ENV PATH="${ANALYSIS_VENV}/bin:/opt/opencode/tools/bin:${PATH}"
RUN printf '%s\n' \
		'export ANALYSIS_VENV=/opt/analysis-venv/.venv' \
		'export PATH="${ANALYSIS_VENV}/bin:/opt/opencode/tools/bin:$PATH"' \
		> /etc/profile.d/opencode-analysis.sh \
	&& chmod 0644 /etc/profile.d/opencode-analysis.sh

RUN useradd -m -s /bin/bash opencode \
	&& mkdir -p /home/opencode/workspace /home/opencode/data \
	&& chown -R opencode:opencode /home/opencode

USER opencode
WORKDIR /home/opencode/workspace
RUN git init && git config user.email "test@test.com" && git config user.name "Test"

ENV OPENCODE_OFFLINE_MODE=true
ENV OPENCODE_OFFLINE_DEPS_PATH=/opt/opencode/deps
ENV OPENCODE_DISABLE_AUTOUPDATE=true
ENV OPENCODE_DISABLE_LSP_DOWNLOAD=true
ENV OPENCODE_DISABLE_MODELS_FETCH=true

ENTRYPOINT ["/opt/opencode/opencode-offline"]
